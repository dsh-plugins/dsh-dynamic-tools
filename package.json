{
  "name": "@dsh-plugin/dsh-dynamic-tools",
  "version": "0.1.0",
  "type": "module",
  "description": "Keeps the tool declaration head of a request frozen and discloses tools registered later as trailing context, so mid-conversation tool changes stop invalidating the cached prompt prefix; routes that call only declared tools load those definitions on demand and get them declared instead.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src/**/*.ts",
    "lib/client.js.map",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.build.json && tsdown --config tsdown.client.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "pretest": "npm run build",
    "test": "node --test \"tests/*.test.ts\"",
    "prepack": "npm run build"
  },
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-dynamic-tools.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "tools",
    "prompt-cache"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.2",
    "@dsh-plugin/dsh-loader": "^2.0.0-dev.45136353623"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "typescript": "5.9.3",
    "@dsh-plugin/dsh-loader": "2.0.0-dev.45136353623",
    "tsdown": "0.22.2",
    "jsdom": "^26.1.0"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@dsh-plugin/dsh-loader", "@deepseek-ai/dsh-client-connection"]
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  }
}
