{
  "name": "@dsh-plugin/dsh-dynamic-tools",
  "version": "0.1.0",
  "type": "module",
  "description": "Keeps the tool declaration head of a request frozen and discloses tools registered later as trailing context, so mid-conversation tool changes stop invalidating the cached prompt prefix.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src/**/*.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "prepack": "npm run build"
  },
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-dynamic-tools.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "tools",
    "prompt-cache"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.2",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
